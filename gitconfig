[user]
  name = Aleksandr Grekhov
  email = aleksandrgrekhov1987@gmail.com
[init]
  defaultBranch = main
[core]
  editor = nvim
[merge]
  tool = nvimdiff
  layout = "LOCAL,BASE,REMOTE / MERGED"
[color]
  ui = auto
[credential]
  helper = cache
[crendential]
  helper = cache
[alias]
  co = checkout
  br = branch
  ci = commit
  st = status
  dc = diff --cached
  poh = push origin HEAD
[pull]
  ff = only
